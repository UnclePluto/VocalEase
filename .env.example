DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=vocaease.settings.local
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
AUTH_WEB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEB_PORT=3000
SERVER_PORT=8000
POSTGRES_DB=vocaease
POSTGRES_USER=vocaease
POSTGRES_PASSWORD=vocaease
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
LOG_LEVEL=INFO
ANALYSIS_TASK_LEASE_SECONDS=300
MEDIA_BACKEND=local
MEDIA_ENVIRONMENT=local
MEDIA_LOCAL_ROOT=/app/private-media
MEDIA_UPLOAD_GRANT_TTL_SECONDS=900
MEDIA_PRIVATE_URL_TTL_SECONDS=600
MEDIA_AUDIO_MAX_BYTES=52428800
MEDIA_VIDEO_MAX_BYTES=524288000
MEDIA_OTHER_MAX_BYTES=10485760
MEDIA_SCANNER_MAX_MARKERS=1000
MEDIA_SCANNER_MAX_MARKER_BYTES=65536
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
QINIU_CALLBACK_URL=
QINIU_UPLOAD_URL=https://up.qiniup.com
QINIU_RS_HOST=https://rs.qiniu.com
QINIU_STAT_TIMEOUT_SECONDS=5
ANALYTICS_SYNC_EXPORT_LIMIT=1000
ANALYTICS_EXPORT_TTL_SECONDS=86400
ANALYTICS_EXPORT_LEASE_SECONDS=300
ANALYTICS_EXPORT_HEARTBEAT_SECONDS=60
ANALYTICS_EXPORT_MAX_ATTEMPTS=4
# 七牛公开媒体来源；多个 HTTPS 来源用空格分隔，例如 https://media.example.test
WEB_MEDIA_ORIGIN=

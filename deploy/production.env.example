# 保存为 /home/motioncare/vocaease-production/.env，权限 600。不要提交真实值。
DJANGO_SETTINGS_MODULE=vocaease.settings.base
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=vocaease.whestsun.com,vocaease-api.whestsun.com,localhost,127.0.0.1
AUTH_WEB_ALLOWED_ORIGINS=https://vocaease.whestsun.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
POSTGRES_DB=vocaease
POSTGRES_USER=vocaease
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
MEDIA_BACKEND=qiniu
MEDIA_ENVIRONMENT=vocaease-production
MEDIA_LOCAL_ROOT=/app/private-media
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=https://cdn.whestsun.com
QINIU_CALLBACK_URL=https://vocaease-api.whestsun.com/api/v1/media/qiniu/callback/
QINIU_UPLOAD_URL=https://up-z2.qiniup.com
WEB_MEDIA_ORIGIN=https://cdn.whestsun.com https://up-z2.qiniup.com
LOG_LEVEL=INFO
